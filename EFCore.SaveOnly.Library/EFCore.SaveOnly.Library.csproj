<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>EFCore.SaveOnly</PackageId>
    <Title>EF Core SaveOnly Extension Method</Title>
    <Version>1.0.1</Version>
    <Company>Adam O'Neil</Company>
    <Copyright>Copyright (c) 2026 Adam O'Neil</Copyright>
    <PackageProjectUrl>https://github.com/adamfoneil/EFCore.SaveOnly</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/adamfoneil/EFCore.SaveOnly</RepositoryUrl>
    <PackageTags>efcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Pass explicit unit of work delegate to EF Core instead of using its built-in change tracking</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
  </ItemGroup>

</Project>
